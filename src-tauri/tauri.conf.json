{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Modem Cat",
  "identifier": "com.modemcat.desktop",
  "version": "0.2.1",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../src/desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Modem Cat",
        "width": 1257,
        "height": 978,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.ico",
      "iconAsTemplate": false,
      "menuOnLeftClick": false
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    }
  }
}
